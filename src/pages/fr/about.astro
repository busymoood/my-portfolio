---
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutPage from '../../components/AboutPage.astro';

const fr = await getEntry('about', 'fr');
const about = fr ?? (await getEntry('about', 'en'));
if (!about) {
  throw new Error('Missing About content (content/about/en/index.md)');
}
---

<BaseLayout lang="fr" title={about.data.title} description={about.data.summary}>
  <AboutPage lang="fr" about={about} fallback={!fr} />
</BaseLayout>
