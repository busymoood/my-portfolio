---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogPost from '../../../components/BlogPost.astro';
import { type Lang } from '../../../i18n/ui';
import { postSlug } from '../../../lib/slugs';

const lang: Lang = 'fr';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.summary} noindex={post.data.draft}>
  <BlogPost lang={lang} post={post} />
</BaseLayout>
