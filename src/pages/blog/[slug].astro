---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { type Lang } from '../../i18n/ui';
import { postSlug } from '../../lib/slugs';

const lang: Lang = 'en';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => post.data.lang === 'en')
    // Drafts stay reachable in `astro dev` but are never built in production.
    .filter((post) => !import.meta.env.PROD || !post.data.draft)
    .map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
---

<BaseLayout lang={lang} title={post.data.title} description={post.data.summary} noindex={post.data.draft}>
  <BlogPost lang={lang} post={post} />
</BaseLayout>
