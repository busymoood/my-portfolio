---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogPost from '../../components/BlogPost.astro';
import { postSlug } from '../../lib/slugs';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((post) => !import.meta.env.PROD || !post.data.draft)
    .map((post) => ({ params: { slug: postSlug(post) }, props: { post } }));
}

const { post } = Astro.props;
---

<BaseLayout title={post.data.title} description={post.data.summary} noindex={post.data.draft}>
  <BlogPost post={post} />
</BaseLayout>
