---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { useTranslations } from '../i18n/ui';
import { formatDate } from '../lib/dates';
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const t = useTranslations();
const { Content } = await render(post);
---

<Breadcrumb items={[{ label: t('blog.back'), href: '/blog' }, { label: post.data.title }]} />

<div class="container">
  <header class="post-header">
    <h1>{post.data.title}</h1>
    <p class="post-header__meta mono">
      <span>{formatDate(post.data.date)}</span>
      {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
      {post.data.draft && <span class="tag post-header__draft">{t('blog.draft')}</span>}
    </p>
  </header>

  {post.data.draft && <p class="post-draft-note mono">{t('blog.draftNote')}</p>}

  <div class="prose article">
    <Content />
  </div>

  <p class="post-back mono">
    <a href="/blog">← {t('blog.back')}</a>
  </p>
</div>

<style>
  .post-header h1 {
    max-width: var(--measure);
  }

  .post-header__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-3);
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .post-header__draft {
    border-style: dashed;
    color: var(--color-accent);
  }

  .post-draft-note {
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .post-draft-note::before {
    content: '> ';
    color: var(--color-accent);
  }

  .post-draft-note {
    margin-block: var(--space-4) var(--space-5);
  }

  .post-back {
    margin-top: var(--space-6);
    font-size: 0.85rem;
  }

  .post-back a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .post-back a:hover {
    color: var(--color-accent);
  }
</style>
