---
import { localizePath, stripLocale, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const otherLang: Lang = lang === 'en' ? 'fr' : 'en';
const switchHref = localizePath(stripLocale(Astro.url.pathname), otherLang);

const links = [
  { href: localizePath('/cv', lang), label: t('nav.cv') },
  { href: localizePath('/projects', lang), label: t('nav.projects') },
  { href: localizePath('/blog', lang), label: t('nav.blog') },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href={localizePath('/', lang)}>{t('site.title')}</a>
    <nav class="site-header__nav" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <button
      class="site-header__theme"
      type="button"
      data-label-light={t('theme.toLight')}
      data-label-dark={t('theme.toDark')}
      data-text-light={t('theme.light')}
      data-text-dark={t('theme.dark')}
      aria-label={t('theme.toLight')}
    >
      {t('theme.light')}
    </button>
    <a class="site-header__lang" href={switchHref} aria-label={t('lang.aria')} hreflang={otherLang}>
      {otherLang.toUpperCase()}
    </a>
  </div>
</header>

<script>
  const button = document.querySelector('button.site-header__theme') as HTMLButtonElement | null;
  const root = document.documentElement;

  /** Keep the toggle label + aria-label pointing at the theme it switches to. */
  function syncToggle() {
    if (!button) return;
    const isLight = root.dataset.theme === 'light';
    button.textContent = isLight
      ? (button.dataset.textDark ?? 'dark')
      : (button.dataset.textLight ?? 'light');
    button.setAttribute(
      'aria-label',
      isLight
        ? (button.dataset.labelDark ?? 'Switch to dark theme')
        : (button.dataset.labelLight ?? 'Switch to light theme'),
    );
  }

  function syncThemeColor() {
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) {
      meta.setAttribute(
        'content',
        getComputedStyle(root).getPropertyValue('--color-bg').trim(),
      );
    }
  }

  function applyTheme(theme: string) {
    root.dataset.theme = theme;
    syncThemeColor();
    syncToggle();
  }

  if (button) {
    syncToggle();
    // Re-sync the browser-bar colour now that stylesheets are applied
    // (the inline head script may run before tokens.css is parsed).
    syncThemeColor();

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      applyTheme(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable — choice applies to this visit only */
      }
    });

    // Before an explicit choice is stored, keep following the system preference.
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
      let stored = null;
      try {
        stored = localStorage.getItem('theme');
      } catch {
        /* storage unavailable */
      }
      if (stored === 'light' || stored === 'dark') return;
      applyTheme(event.matches ? 'light' : 'dark');
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--header-height);
  }

  .site-header__brand {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
  }

  .site-header__brand:hover {
    color: var(--color-accent);
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-4);
    margin-left: auto;
  }

  .site-header__nav a {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--color-accent);
  }

  .site-header__theme {
    border: 0;
    border-left: 1px solid var(--color-border);
    padding-left: var(--space-3);
    background: none;
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .site-header__theme:hover {
    color: var(--color-accent);
  }

  .site-header__lang {
    padding-left: var(--space-3);
    border-left: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .site-header__lang:hover {
    color: var(--color-accent);
  }

  @media (max-width: 30rem) {
    .site-header__nav {
      gap: var(--space-2);
    }

    .site-header__brand {
      font-size: 0.85rem;
    }
  }
</style>
