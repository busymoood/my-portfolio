---
import { useTranslations } from '../i18n/ui';

const t = useTranslations();

const links = [
  { href: '/about', label: t('nav.about') },
  { href: '/cv', label: t('nav.cv') },
  { href: '/projects', label: t('nav.projects') },
  { href: '/blog', label: t('nav.blog') },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="/">Julien</a>
    <nav class="site-header__nav" aria-label="Main">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <button
      class="site-header__theme"
      type="button"
      data-label-light={t('theme.toLight')}
      data-label-dark={t('theme.toDark')}
      aria-label={t('theme.toLight')}
    >
      <svg class="theme-icon theme-icon--sun" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M19.1 4.9l-1.8 1.8M6.7 17.3l-1.8 1.8" />
      </svg>
      <svg class="theme-icon theme-icon--moon" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M20.3 13.5A8.5 8.5 0 1 1 10.5 3.7a7 7 0 0 0 9.8 9.8z" />
      </svg>
    </button>
  </div>
</header>

<script>
  const button = document.querySelector('button.site-header__theme') as HTMLButtonElement | null;
  const root = document.documentElement;

  /** Keep the toggle aria-label pointing at the theme it switches to. */
  function syncToggle() {
    if (!button) return;
    const isLight = root.dataset.theme === 'light';
    button.setAttribute(
      'aria-label',
      isLight
        ? (button.dataset.labelDark ?? 'Switch to dark theme')
        : (button.dataset.labelLight ?? 'Switch to light theme'),
    );
  }

  function syncThemeColor() {
    const meta = document.querySelector('meta[name="theme-color"]');
    if (meta) {
      meta.setAttribute(
        'content',
        getComputedStyle(root).getPropertyValue('--color-bg').trim(),
      );
    }
  }

  function applyTheme(theme: string) {
    root.dataset.theme = theme;
    syncThemeColor();
    syncToggle();
  }

  if (button) {
    syncToggle();
    // Re-sync the browser-bar colour now that stylesheets are applied
    // (the inline head script may run before tokens.css is parsed).
    syncThemeColor();

    button.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      applyTheme(next);
      try {
        localStorage.setItem('theme', next);
      } catch {
        /* storage unavailable — choice applies to this visit only */
      }
    });

    // Before an explicit choice is stored, keep following the system preference.
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', (event) => {
      let stored = null;
      try {
        stored = localStorage.getItem('theme');
      } catch {
        /* storage unavailable */
      }
      if (stored === 'light' || stored === 'dark') return;
      applyTheme(event.matches ? 'light' : 'dark');
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--color-bg) 92%, transparent);
    border-bottom: 1px solid var(--color-border);
    backdrop-filter: blur(8px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--header-height);
  }

  .site-header__brand {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-header__brand:hover {
    color: var(--color-accent);
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-4);
    margin-left: auto;
  }

  .site-header__nav a {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .site-header__nav a:hover {
    color: var(--color-accent);
  }

  .site-header__theme {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-left: 1px solid var(--color-border);
    padding: 0.35rem 0.55rem 0.35rem var(--space-3);
    background: none;
    color: var(--color-text-muted);
    cursor: pointer;
  }

  .site-header__theme:hover {
    color: var(--color-accent);
  }

  /* In dark mode the icon points at light (sun); in light mode, at dark (moon). */
  .theme-icon {
    display: none;
  }

  :global([data-theme='dark']) .site-header__theme .theme-icon--sun,
  :global([data-theme='light']) .site-header__theme .theme-icon--moon {
    display: block;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .site-header__theme .theme-icon--moon {
      display: block;
    }

    :global(:root:not([data-theme='dark'])) .site-header__theme .theme-icon--sun {
      display: none;
    }
  }

  @media (max-width: 34rem) {
    .site-header__inner {
      flex-wrap: wrap;
      row-gap: var(--space-1);
      padding-block: var(--space-1);
    }

    .site-header__brand {
      font-size: 0.85rem;
      white-space: nowrap;
    }

    /* Keep the brand and the theme toggle on the first row, and give the
       four navigation links their own full-width row on small screens. */
    .site-header__nav {
      order: 4;
      flex-basis: 100%;
      margin-left: 0;
      gap: var(--space-3);
    }

    .site-header__theme {
      order: 2;
      margin-left: auto;
    }
  }
</style>
