---
import { existsSync } from 'node:fs';
import { useTranslations, type Lang } from '../i18n/ui';
import PageIntro from '../components/PageIntro.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The PDF is downloaded from the latest `cv-*` Release by the site CI into
// public/pdf/ before `astro build`. When no Release exists yet, the embed
// and the button would be dead: show a note instead.
const pdfAvailable = existsSync('public/pdf/my_cv.pdf');
---

<div class="container">
  <PageIntro title={t('cv.title')} intro={t('cv.intro')} />

  <div class="cv">
    {
      pdfAvailable ? (
        <>
          <div class="cv__actions">
            <a class="button button--primary" href="/pdf/my_cv.pdf" download>
              {t('cv.download')}
            </a>
            <p class="cv__note mono">{t('cv.note')}</p>
          </div>

          <div class="cv__preview">
            <p class="cv__preview-label mono">{t('cv.preview')}</p>
            <embed
              class="cv__embed"
              src="/pdf/my_cv.pdf"
              type="application/pdf"
              title={t('cv.title')}
            />
          </div>
        </>
      ) : (
        <p class="cv__pending mono">{t('cv.unavailable')}</p>
      )
    }
  </div>
</div>

<style>
  .cv {
    display: grid;
    gap: var(--space-5);
    max-width: 54rem;
    padding-block: var(--space-2) var(--space-5);
  }

  .cv__actions {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
    max-width: var(--measure);
  }

  .cv__note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .cv__preview {
    display: grid;
    gap: var(--space-2);
  }

  .cv__preview-label {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
  }

  /* Native browser PDF viewer: the document keeps its own (light) rendering,
     framed to match the site's borders. */
  .cv__embed {
    display: block;
    width: 100%;
    height: min(85vh, 75rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .cv__pending {
    max-width: var(--measure);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius);
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .cv__pending::before {
    content: '> ';
    color: var(--color-accent);
  }
</style>
