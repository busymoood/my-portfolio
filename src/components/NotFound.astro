---
import { useTranslations } from '../i18n/ui';

const t = useTranslations();
---

<div class="container">
  <div class="notfound">
    <p class="notfound__prompt mono" aria-hidden="true">
      <span class="notfound__symbol">$</span> cat <span class="notfound__path">/…</span>
    </p>
    <p class="notfound__code mono" aria-hidden="true">404</p>
    <h1>{t('notfound.title')}</h1>
    <p class="notfound__body">{t('notfound.body')}</p>
    <a class="button" href="/">{t('notfound.cta')}</a>
  </div>
</div>

<style>
  .notfound {
    padding-block: var(--space-7);
  }

  .notfound__prompt {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .notfound__symbol {
    color: var(--color-accent);
  }

  .notfound__code {
    margin-top: var(--space-5);
    color: var(--color-border-strong);
    font-size: clamp(4rem, 18vw, 9rem);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.06em;
    user-select: none;
  }

  h1 {
    margin-block: var(--space-4) var(--space-2);
    font-size: clamp(1.5rem, 4vw, 2.25rem);
  }

  .notfound__body {
    max-width: var(--measure);
    margin-bottom: var(--space-5);
    color: var(--color-text-muted);
  }
</style>

<!-- Static 404: fill in the path actually requested by the visitor. -->
<script is:inline>
  const pathEl = document.querySelector('.notfound__path');
  if (pathEl) pathEl.textContent = window.location.pathname;
</script>
