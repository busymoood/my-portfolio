---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/ui';
import { projectSlug } from '../lib/slugs';
import ProjectCard from './ProjectCard.astro';

interface Props {
  /** Keep only the first N entries (used by the home page highlights). */
  limit?: number;
}

const { limit } = Astro.props;
const t = useTranslations();

// Curated order: flagships first, then the companion guide. Slugs not listed
// here keep the alphabetical fallback, so adding a project stays a one-file job.
const PROJECT_ORDER = ['relic-core', 'ovalbot', 'relic-hw'];

function orderRank(slug: string): number {
  const index = PROJECT_ORDER.indexOf(slug);
  return index === -1 ? PROJECT_ORDER.length : index;
}

let projects = await getCollection('projects');
projects = projects.sort((a, b) => {
  const rank = orderRank(projectSlug(a)) - orderRank(projectSlug(b));
  return rank !== 0 ? rank : projectSlug(a).localeCompare(projectSlug(b));
});
if (limit) projects = projects.slice(0, limit);
---

{
  projects.length === 0 ? (
    <p class="empty mono">{t('projects.empty')}</p>
  ) : (
    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard
          project={project}
          href={`/projects/${projectSlug(project)}`}
        />
      ))}
    </div>
  )
}

<style>
  .project-grid {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
  }

  .empty {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .empty::before {
    content: '> ';
    color: var(--color-accent);
  }
</style>
