# Variables du conteneur devbox — copier en .env (ignoré par git) :
#   cp .env.example .env
#
# Ce fichier n'est PAS lu tel quel par la CLI devcontainers : lancer
#   ./scripts/devbox-up.sh
# (qui exporte ces variables avant `devcontainer up`). `docker compose` lit
# `.env` nativement.

# Repo de dotfiles (zsh/tmux/ssh). Placeholder actuel : ce repo (l'image)
# ne contient pas de zsh/.zshrc ni tmux/.tmux.conf, donc rien n'est lié.
DOTFILES_REPO=git@github.com:busymoood/dotfiles-docker.git

# Config NeoVim/LazyVim (dépôt privé → agent SSH requis ; "" = nvim nu)
NVIM_CONFIG_REPO=git@github.com:Thejulfi/lazyvim-config.git

# --- Optionnel ---------------------------------------------------------------
# Cible du relais TCP de l'agent SSH (Docker Desktop)
# DEVBOX_SSH_RELAY_TARGET=host.docker.internal:4242
# Socket de l'agent dans le conteneur (Docker Desktop) ;
# sur Docker natif, utiliser /ssh-agent + monter le socket.
# DEVBOX_SSH_AUTH_SOCK=/tmp/ssh-agent.sock
