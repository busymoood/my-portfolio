{
  "name": "myportfolio-dev",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  // Features : CLI Docker (via socket de l'hôte) — gh est installé dans le Dockerfile
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "overrideCommand": true,
  "remoteUser": "dev",
  // Configs hôtes montées dans le conteneur :
  // nvim (config + plugins LazyVim) — lazygit — OpenCode (config + état/auth)
  "mounts": [
    "source=${localEnv:HOME}/.config/nvim,target=/home/dev/.config/nvim,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.local/share/nvim,target=/home/dev/.local/share/nvim,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/lazygit,target=/home/dev/.config/lazygit,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/opencode,target=/home/dev/.config/opencode,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.local/share/opencode,target=/home/dev/.local/share/opencode,type=bind,consistency=cached"
  ],
  "forwardPorts": [4321],
  "postCreateCommand": "latexmk -v"
}
