// .devcontainer/devcontainer.json — conteneur « devbox »
// Source de vérité : devbox-install-agents.md (ne pas configurer l'environnement
// à la main). L'image publiée busymoood/dotfiles-docker fournit zsh/tmux/nvim
// LazyVim/lazygit/opencode avec les configs personnelles INTÉGRÉES : aucun
// clone de dotfiles au démarrage. L'état des outils (plugins nvim, Mason, auth
// opencode, browsers Playwright) persiste dans le volume `devbox-home`.
// Aucune clé privée ne vit dans le conteneur — l'agent SSH de l'hôte est exposé
// par `devbox-agent-relay` (image) : montage direct sur Docker natif, relais TCP
// sur Docker Desktop.
{
  "name": "devbox",
  "image": "ghcr.io/busymoood/dotfiles-docker:main",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  // Compléments sur l'image (absents d'elle) : Node 22 (build du site Astro),
  // gh (GitHub CLI), client Docker via le socket de l'hôte.
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "containerEnv": {
    // L'agent SSH de l'hôte (Bitwarden) est forwarded dans le conteneur.
    "GIT_SSH_COMMAND": "ssh -o StrictHostKeyChecking=accept-new",
    "SSH_AUTH_SOCK": "${localEnv:DEVBOX_SSH_AUTH_SOCK:/tmp/ssh-agent.sock}",
    // Browsers Playwright dans le volume persistant (state devbox-home)
    "PLAYWRIGHT_BROWSERS_PATH": "/home/dev/.local/ms-playwright"
  },
  "mounts": [
    // État persistant des outils, partagé avec les autres sessions devbox.
    "source=devbox-home,target=/home/dev/.local,type=volume"
  ],
  // Port 4321 publié sur loopback (Astro). `runArgs` fait le `docker -p`
  // pour la CLI ; `forwardPorts` sert les clients éditeur (VS Code).
  "runArgs": ["--publish", "127.0.0.1:4321:4321"],
  "forwardPorts": [4321],
  // Provisionnement du projet (playwright, chromium) — une fois par création.
  "postCreateCommand": "bash /workspace/scripts/devbox-bootstrap.sh create",
  // Chaque démarrage : relais de l'agent SSH puis bootstrap local (volume, agent).
  "postStartCommand": "bash /workspace/scripts/devbox-bootstrap.sh start"
}
