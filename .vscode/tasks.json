{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CV: Build PDF",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-output-directory=latex",
        "latex/my_cv.tex"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "CV: Watch and rebuild",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-pvc",
        "-pdf",
        "-interaction=nonstopmode",
        "-halt-on-error",
        "-file-line-error",
        "-output-directory=latex",
        "latex/my_cv.tex"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "CV: Clean",
      "type": "shell",
      "command": "latexmk",
      "args": [
        "-C",
        "-output-directory=latex",
        "latex/my_cv.tex"
      ],
      "problemMatcher": []
    }
  ]
}
